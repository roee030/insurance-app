# ── Server ─────────────────────────────────────────────
PORT=4000
# Public URL of THIS server, used to build the webhook callback URL
# that Mislaka posts back to. In production this must be a real HTTPS URL.
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call the API (the Vite frontend)
CORS_ORIGIN=http://localhost:5199

# ── Mislaka API ────────────────────────────────────────
# "mock" = local simulator (no cost, no credentials needed) — use for dev.
# "live" = real Nobel Digital / Swiftness endpoint (needs a real token).
MISLAKA_MODE=mock
MISLAKA_BASE_URL=https://mislaka-api.co.il/api
MISLAKA_TOKEN=
# The agent's ID number (ת.ז הסוכן) — the sender_id on requests.
MISLAKA_SENDER_ID=

# ── Mock behaviour ─────────────────────────────────────
# How long the simulator waits before firing the "finished" webhook.
MOCK_WEBHOOK_DELAY_MS=6000
